[Unit]
Description=GoldenGoosePOS FastAPI Server
After=network.target postgresql.service

[Service]
User=ntvelop
WorkingDirectory=/home/ntvelop/goldengoose/server
ExecStart=/home/ntvelop/goldengoose/server/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
